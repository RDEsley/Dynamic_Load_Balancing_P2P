# Copie para .env e ajuste IP/portas conforme o ambiente (lab, grupo, vizinhos).
#
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env

# ---------------------------------------------------------------------------
# Identidade do Master (obrigatório para o dashboard Sprint 4)
# ---------------------------------------------------------------------------
SERVER_UUID=master_3
HOSTNAME=master_3_a_local

# ---------------------------------------------------------------------------
# Master P2P — protocolo JSON na rede do lab
# ---------------------------------------------------------------------------
MASTER_HOST=0.0.0.0
MASTER_PORT=9000
CAPACITY=4
RELEASE_THRESHOLD=2
TASK_COUNT=50
WORKER_TTL=25

# Vizinhos Master-to-Master (Sprint 3): nome=IP:porta, separados por vírgula
NEIGHBORS=grupo_b=192.168.x.x:9000

# ---------------------------------------------------------------------------
# Worker — descomente ao rodar worker.py (use IP real do master, não 0.0.0.0)
# ---------------------------------------------------------------------------
# MASTER_HOST=127.0.0.1
# MASTER_PORT=9000
# MASTER_SERVER_UUID=master_3

# ---------------------------------------------------------------------------
# Supervisor Sprint 4 — métricas TLS para nuted-ia.dev (porta 443)
# ---------------------------------------------------------------------------
SUPERVISOR_ENABLED=true
SUPERVISOR_HOST=nuted-ia.dev
SUPERVISOR_PORT=443
SUPERVISOR_TLS=true
SUPERVISOR_SNI=nuted-ia.dev
SUPERVISOR_INTERVAL=10
PAYLOAD_VERSION=sprint4-monitor

# Desenvolvimento local sem enviar ao professor:
# SUPERVISOR_ENABLED=false
