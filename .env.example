# Master — escuta em todas as interfaces
MASTER_HOST=0.0.0.0
MASTER_PORT=9000
SERVER_UUID=Master_A

# Vizinhos P2P (ip:porta separados por vírgula)
NEIGHBORS=

# Carga e balanceamento
TASK_COUNT=50
CAPACITY=4
RELEASE_THRESHOLD=2

# Worker — IP do master ao qual conectar (use 127.0.0.1 se master estiver na mesma máquina)
# MASTER_HOST=127.0.0.1
# MASTER_PORT=9000
