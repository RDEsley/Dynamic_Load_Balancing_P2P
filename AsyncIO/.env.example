# Copie para .env e ajuste IP/portas da sua rede.
# NUM_TASKS > CAPACITY (ex.: 120 > 100) apenas no Master saturado (A).

# --- Master B (vizinho) ---
HOST=0.0.0.0
PORT=8001
SERVER_UUID=Master_B
MASTER_ID=B
CAPACITY=100
NUM_TASKS=0
NEIGHBOR_MASTERS=A=192.168.1.15:8000

# --- Worker do Master B (descomente se rodar worker.py na mesma pasta) ---
MASTER_HOST=192.168.1.15
WORKER_UUID=Worker_1
ORIGINAL_MASTER_ID=B

# --- Master A (saturado) — use em outra instancia ou troque valores acima ---
# PORT=8000
# MASTER_ID=A
# NUM_TASKS=120
# NEIGHBOR_MASTERS=B=192.168.1.15:8001
